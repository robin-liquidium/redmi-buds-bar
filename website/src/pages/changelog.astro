---
import Site from '../layouts/Site.astro';
import releases from '../../public/releases.json';
const entries = releases as {
  version: string;
  date: string;
  changes: string[];
}[];
---

<Site title="Changelog — Redmi Buds Bar">
  <main id="main" class="rb-prose rb-shell">
    <h1>Changelog</h1>
    <p class="rb-lede">What changed in each version of Redmi Buds Bar.</p>
    {entries.length ? (
      entries.map((release) => (
        <article class="rb-release">
          <div class="rb-release-head">
            <h2>Version {release.version}</h2>
            <time datetime={release.date}>{release.date}</time>
          </div>
          <ul>
            {release.changes.map((change) => (
              <li>{change}</li>
            ))}
          </ul>
          <a
            href={`https://github.com/robin-liquidium/redmi-buds-bar/releases/tag/v${release.version}`}
          >
            Release notes & downloads
          </a>
        </article>
      ))
    ) : (
      <p>
        The first public release is being prepared.{' '}
        <a href="https://github.com/robin-liquidium/redmi-buds-bar/releases">
          Follow along on GitHub
        </a>
      </p>
    )}
  </main>
</Site>
