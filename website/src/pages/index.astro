---
import Closing from '@robin-build/landing-kit/components/Closing.astro';
import Facts from '@robin-build/landing-kit/components/Facts.astro';
import Faq from '@robin-build/landing-kit/components/Faq.astro';
import FeatureList from '@robin-build/landing-kit/components/FeatureList.astro';
import Hero from '@robin-build/landing-kit/components/Hero.astro';
import Section from '@robin-build/landing-kit/components/Section.astro';
import Stage from '../components/Stage.astro';
import Site from '../layouts/Site.astro';
import releases from '../../public/releases.json';

const latest = releases[0] as { version: string } | undefined;
const [major, minor] = latest?.version.split('.').map(Number) ?? [0, 0];
const hasIPhonePackage = major > 0 || minor >= 5;
const repo = 'https://github.com/robin-liquidium/redmi-buds-bar';
const download = latest ? '/download' : `${repo}/releases`;

const facts = [
  { value: '20', label: 'noise cancelling strengths, from a little to a lot' },
  { value: '3', label: 'transparency modes: Regular, Voice and Ambient' },
  { value: '3', label: 'battery levels at a glance: left, right and case' },
  { value: '0', label: 'accounts, analytics or phones needed' },
];

const features = [
  {
    title: 'Find your quiet',
    text: 'Turn noise cancelling on and set its strength with 20 steps, from taking the edge off to near silence.',
  },
  {
    title: 'Let the world in',
    text: 'Switch to Regular, Voice or Ambient transparency, or turn noise control off. Your earbuds confirm every change.',
  },
  {
    title: 'Battery at a glance',
    text: 'See each earbud’s charge, and the case when your earbuds report it, without picking up your phone.',
  },
  {
    title: 'Gestures and sound',
    text: 'Change what taps and presses do, pick an EQ preset and adjust supported audio settings from your Mac.',
  },
  {
    title: 'Firmware updates',
    text: 'Install official firmware updates for your earbuds straight from your Mac.',
  },
  {
    title: 'Always there',
    text: 'Launch at login and it waits in the menu bar. Signed automatic updates keep it current.',
  },
];

const faq = [
  {
    q: 'What is Redmi Buds Bar?',
    a: 'A free Mac app that puts your REDMI Buds 8 Pro controls in the menu bar: noise cancelling, transparency, battery levels, gestures, EQ and firmware updates.',
  },
  {
    q: 'Which earbuds does it support?',
    a: 'REDMI Buds 8 Pro, tested with the Chinese variant on firmware 1.2.3.6 and 1.2.3.7. Other models and regional variants haven’t been verified yet.',
  },
  {
    q: 'How do I set it up?',
    a: 'Pair your earbuds in Bluetooth settings, open Redmi Buds Bar and click the earbuds icon in the menu bar. That’s it.',
  },
  {
    q: 'Which Macs does it run on?',
    a: 'Any Mac with Apple silicon or Intel running macOS Sonoma 14 or later.',
  },
  {
    q: 'Do I need the Xiaomi app or an account?',
    a: 'No. It talks to your earbuds directly over Bluetooth. No account, no analytics, nothing leaves your Mac.',
  },
  {
    q: 'Is it free?',
    a: `Yes. It’s free and open source, <a href="${repo}">on GitHub</a>.`,
  },
  {
    q: 'Is it made by Xiaomi?',
    a: 'No. It’s an independent app and isn’t affiliated with Xiaomi or Redmi.',
  },
  ...(latest && hasIPhonePackage
    ? [
        {
          q: 'Is there an iPhone version?',
          a: `Yes, for iOS 26 or later. <a href="${repo}/releases/download/v${latest.version}/RedmiBuds-${latest.version}-unsigned.ipa">Download the unsigned IPA</a> and <a href="${repo}/blob/main/iOS/SIDELOADING.md">sign it yourself</a> before installing.`,
        },
      ]
    : []),
];
---

<Site>
  <main id="main">
    <Hero
      lines={['Your buds,', 'on your Mac.']}
      lede="Noise cancelling, transparency and battery levels for REDMI Buds 8 Pro, one click away in your menu bar."
      cta={{
        label: latest ? 'Download for Mac' : 'Get the first release',
        href: download,
      }}
      link={{ label: 'See what it does', href: '#features' }}
      notes={[
        'Free and open source',
        'macOS 14 or later',
        ...(latest ? [`Version ${latest.version}`] : []),
      ]}
    >
      <Stage />
    </Hero>

    <Section title="Everything, one click away." layout="stack">
      <Facts items={facts} />
    </Section>

    <Section
      id="features"
      title="Stay in your flow."
      intro="Everything your earbuds can do, without reaching for your phone."
    >
      <FeatureList items={features} />
    </Section>

    <Section id="questions" title="Questions.">
      <Faq items={faq} />
    </Section>

    <Closing
      lines={['One less reason', 'to pick up your phone.']}
      href={download}
      label={latest ? 'Download Redmi Buds Bar' : 'View releases'}
      details={[
        ...(latest ? [`Version ${latest.version}`] : []),
        'macOS 14 or later',
        'Apple silicon and Intel',
      ]}
    >
      {latest && (
        <p class="brew">
          Or with Homebrew:{' '}
          <code>brew install --cask robin-liquidium/tap/redmi-buds-bar</code>
        </p>
      )}
    </Closing>
  </main>
</Site>
