---
import Page from '../layouts/Page.astro';
import releases from '../../public/releases.json';
const latest = releases[0] as { version: string } | undefined;
---

<Page>
  <main id="main">
    <section class="hero">
      <div class="eyebrow">
        <span class="dot"></span> A little app for your Mac
      </div>
      <h1>
        Your buds.
        <br />
        Your <em>controls.</em>
      </h1>
      <p class="intro">
        Good earbuds deserve a place on your Mac.
        <br class="desktop" /> Noise cancelling, transparency, and battery
        levels.
        <br class="desktop" /> Just a click away in your menu bar.
      </p>
      <div class="actions">
        <a
          class="button primary"
          href={
            latest
              ? '/download'
              : 'https://github.com/robin-liquidium/redmi-buds-bar/releases'
          }
        >
          <svg
            width="19"
            height="19"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path d="M12 3v12m-5-5 5 5 5-5M5 16v5h14v-5" />
          </svg>
          {latest ? 'Download for Mac' : 'Get the first release'}
        </a>
        <a class="text-link" href="#how-it-works">
          Take a closer look <span aria-hidden="true">↓</span>
        </a>
      </div>
      <p class="small">
        Free & open source · macOS 14+ · Apple silicon & Intel
        {latest && ` · v${latest.version}`}
      </p>
      <div class="product-stage" aria-label="Screenshot of Redmi Buds Bar">
        <div class="stage-label">
          <span class="tiny-line"></span> Everything you need. Right here.
        </div>
        <svg
          class="screenshot"
          viewBox="20 67 708 873"
          role="img"
          aria-labelledby="screenshot-title"
        >
          <title id="screenshot-title">Redmi Buds Bar showing battery levels, noise controls, and the noise cancelling strength slider.</title>
          <defs>
            <clipPath id="popover-outline" clipPathUnits="userSpaceOnUse">
              <path id="popover-shape" d="M54 89 H344 C357 89 361 82 367 75 Q370 72 373 72 Q377 72 380 75 C386 82 390 89 404 89 H694 A30 30 0 0 1 724 119 V906 A30 30 0 0 1 694 936 H54 A30 30 0 0 1 24 906 V119 A30 30 0 0 1 54 89 Z" />
            </clipPath>
          </defs>
          <image
            href="/images/menu.png"
            x="0"
            y="0"
            width="752"
            height="968"
            clip-path="url(#popover-outline)"
          />
          <use
            href="#popover-shape"
            fill="none"
            stroke="#253a42"
            stroke-opacity="0.16"
            stroke-width="1.2"
          />
        </svg>
        <span class="stage-note">Less reaching for your phone.</span>
      </div>
    </section>
    <section id="how-it-works" class="features">
      <div class="section-heading">
        <span class="eyebrow">Small app. Everyday useful.</span>
        <h2>
          Set the sound.
          <br />
          <em>Stay in your flow.</em>
        </h2>
      </div>
      <div class="feature-grid">
        <article>
          <span class="feature-number">01 / Focus</span>
          <h3>Find your quiet.</h3>
          <p>
            Switch noise cancelling on and dial in the strength with 20 manual
            positions. From a little less noise to a lot more focus.
          </p>
        </article>
        <article>
          <span class="feature-number">02 / Listen</span>
          <h3>Let the world in.</h3>
          <p>
            Choose Regular, Voice, or Ambient transparency. Or turn noise
            control off. Your earbuds confirm every change.
          </p>
        </article>
        <article>
          <span class="feature-number">03 / Glance</span>
          <h3>Keep an eye on battery.</h3>
          <p>
            Check each earbud at a glance. The case level appears when your
            earbuds report it. No phone required.
          </p>
        </article>
        <article>
          <span class="feature-number">04 / Settle in</span>
          <h3>Ready when you are.</h3>
          <p>
            Enable launch at login and let it live in your menu bar. Signed
            automatic updates keep it current.
          </p>
        </article>
      </div>
    </section>
    <section class="compatibility">
      <div>
        <span class="eyebrow">Made for these buds</span>
        <h2>
          REDMI Buds 8 Pro.
          <br />
          <em>Meet your Mac.</em>
        </h2>
      </div>
      <div>
        <p>
          Tested with the <strong>Chinese variant</strong> on firmware{' '}
          <strong>1.2.3.6</strong>. Requires macOS Sonoma 14 or later. Other
          models and regional variants haven’t been verified.
        </p>
        <p>
          Pair your earbuds in Bluetooth settings, open Redmi Buds Bar, and
          click the earbuds icon. That’s it.
        </p>
        <p class="small">
          Controls noise modes and battery display. EQ, gestures, spatial audio,
          and firmware updates stay in Xiaomi’s app.
        </p>
      </div>
    </section>
    <section class="install">
      <h2>
        One less reason
        <br />
        to <em>pick up your phone.</em>
      </h2>
      <a
        class="button primary"
        href={
          latest
            ? '/download'
            : 'https://github.com/robin-liquidium/redmi-buds-bar/releases'
        }
      >
        {latest ? 'Download Redmi Buds Bar' : 'View releases'}{' '}
        <span aria-hidden="true">↓</span>
      </a>
      {latest && (
        <>
          <p class="small">Or, if Homebrew is your thing:</p>
          <code>brew install --cask robin-liquidium/tap/redmi-buds-bar</code>
        </>
      )}
      <p class="small">
        No account. No analytics. Just your buds and your Mac.
      </p>
    </section>
  </main>
</Page>
