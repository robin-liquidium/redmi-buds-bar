---
import Page from '../layouts/Page.astro';
import DownloadIcon from '../components/DownloadIcon.astro';
import releases from '../../public/releases.json';
const latest = releases[0] as { version: string } | undefined;
const [major, minor] = latest?.version.split('.').map(Number) ?? [0, 0];
const hasIPhonePackage = major > 0 || minor >= 5;
const repo = 'https://github.com/robin-liquidium/redmi-buds-bar';
const download = latest ? '/download' : `${repo}/releases`;

const stats = [
  { value: '20', label: 'Noise cancelling strengths to choose from' },
  { value: '3', label: 'Transparency modes: Regular, Voice, Ambient' },
  { value: '1 click', label: 'To switch modes from anywhere on your Mac' },
  { value: '0', label: 'Accounts, analytics or phones needed' },
];

const features = [
  {
    tag: '01 / Focus',
    title: 'Find your quiet.',
    text: 'Switch noise cancelling on and dial in the strength with 20 manual positions. From a little less noise to a lot more focus.',
  },
  {
    tag: '02 / Listen',
    title: 'Let the world in.',
    text: 'Choose Regular, Voice or Ambient transparency, or turn noise control off. Your earbuds confirm every change.',
  },
  {
    tag: '03 / Glance',
    title: 'Keep an eye on battery.',
    text: 'Check each earbud at a glance. The case level appears when your earbuds report it. No phone required.',
  },
  {
    tag: '04 / Settle in',
    title: 'Ready when you are.',
    text: 'Enable launch at login and let it live in your menu bar. Signed automatic updates keep it current.',
  },
];
---

<Page>
  <main id="main">
    <section class="hero">
      <span class="eyebrow">
        <span class="dot"></span> A little app for your Mac
      </span>
      <h1>
        Your buds.
        <br />
        Your <em>controls.</em>
      </h1>
      <p class="intro">
        Noise cancelling, transparency and battery levels
        <br class="desktop" /> for your REDMI Buds, one click away in your menu
        bar.
      </p>
      <div class="actions">
        <a class="button primary" href={download}>
          <DownloadIcon />
          {latest ? 'Download for Mac' : 'Get the first release'}
        </a>
        <a class="text-link" href="#features">
          See what it does
        </a>
      </div>
      <p class="small">
        Free & open source · macOS 14+ · Apple silicon & Intel
        {latest && ` · v${latest.version}`}
      </p>
      <div class="stage">
        <svg
          class="screenshot"
          viewBox="20 67 708 873"
          role="img"
          aria-labelledby="screenshot-title"
        >
          <title id="screenshot-title">Redmi Buds Bar showing battery levels, noise controls, and the noise cancelling strength slider.</title>
          <defs>
            <clipPath id="popover-outline" clipPathUnits="userSpaceOnUse">
              <path
                id="popover-shape"
                d="M54 89 H344 C357 89 361 82 367 75 Q370 72 373 72 Q377 72 380 75 C386 82 390 89 404 89 H694 A30 30 0 0 1 724 119 V906 A30 30 0 0 1 694 936 H54 A30 30 0 0 1 24 906 V119 A30 30 0 0 1 54 89 Z"
              />
            </clipPath>
          </defs>
          <image
            href="/images/menu.png"
            x="0"
            y="0"
            width="752"
            height="968"
            clip-path="url(#popover-outline)"
          />
          <use
            href="#popover-shape"
            fill="none"
            stroke="#ffffff"
            stroke-opacity="0.5"
            stroke-width="1.2"
          />
        </svg>
      </div>
    </section>

    <section class="stats" aria-label="At a glance">
      <span class="eyebrow">At a glance</span>
      <h2>
        Everything that matters. <em>Nothing that doesn’t.</em>
      </h2>
      <dl>
        {stats.map((stat) => (
          <div>
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section id="features" class="how">
      <div class="center">
        <span class="eyebrow">Small app. Everyday useful.</span>
        <h2>
          Set the sound. <em>Stay in your flow.</em>
        </h2>
        <p>Everything your earbuds can do, without reaching for your phone.</p>
      </div>
      <div class="features">
        {features.map((feature) => (
          <article>
            <span class="feature-number">{feature.tag}</span>
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="faq">
      <div>
        <span class="eyebrow">Made for these buds</span>
        <h2>
          REDMI Buds 8 Pro.
          <br />
          <em>Meet your Mac.</em>
        </h2>
      </div>
      <div>
        <details open>
          <summary>Which earbuds does it support?</summary>
          <p>
            REDMI Buds 8 Pro, tested with the Chinese variant on firmware
            1.2.3.6 and 1.2.3.7. Other models and regional variants haven’t been
            verified yet.
          </p>
        </details>
        <details>
          <summary>How do I set it up?</summary>
          <p>
            Pair your earbuds in Bluetooth settings, open Redmi Buds Bar and
            click the earbuds icon in your menu bar. That’s it. You need macOS
            Sonoma 14 or later.
          </p>
        </details>
        <details>
          <summary>What can it control?</summary>
          <p>
            Noise controls, battery levels, gestures, EQ, supported audio
            settings and official firmware updates. New setting writes, fit
            tests and find sounds still need testing on more earbuds.
          </p>
        </details>
        {latest && hasIPhonePackage && (
          <details>
            <summary>Is there an iPhone version?</summary>
            <p>
              Yes, for iOS 26 or later.{' '}
              <a
                href={`${repo}/releases/download/v${latest.version}/RedmiBuds-${latest.version}-unsigned.ipa`}
              >
                Download the unsigned IPA
              </a>
              . You’ll{' '}
              <a href={`${repo}/blob/main/iOS/SIDELOADING.md`}>
                sign it yourself
              </a>{' '}
              before installing.
            </p>
          </details>
        )}
      </div>
    </section>

    <section class="install">
      <h2>
        One less reason <br />
        <em>to pick up your phone.</em>
      </h2>
      <a class="button primary" href={download}>
        <DownloadIcon />
        {latest ? 'Download Redmi Buds Bar' : 'View releases'}
      </a>
      {latest && (
        <p class="small">
          Or with Homebrew:
          <code>brew install --cask robin-liquidium/tap/redmi-buds-bar</code>
        </p>
      )}
      <p class="small">
        No account. No analytics. Just your buds and your Mac.
      </p>
    </section>
  </main>
</Page>
